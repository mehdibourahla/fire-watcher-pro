# Supabase — publishable values are safe to commit; the service role key is not.
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-side only. Bypasses RLS — never expose to the browser and never commit.
SUPABASE_SERVICE_ROLE_KEY=""

# Ingestion credentials (server-side)
FIRMS_MAP_KEY=""
EUMETSAT_CONSUMER_KEY=""
EUMETSAT_CONSUMER_SECRET=""

# Shared secret the pg_cron scheduler presents to /api/public/cron/*
LOVABLE_CRON_SECRET=""
